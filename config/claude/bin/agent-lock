#!/usr/bin/env python3
"""Share a named resource between agents through kernel file locks.

Each resource NAME has a permanent lock file NAME.lock in the state directory.
Whoever holds an exclusive flock(2) on it owns the resource. The kernel grants
that lock to one holder at a time and drops it when the holder exits, so two
agents cannot both win, and a crash cannot leave the resource locked.

The lock file is never deleted. Unlinking it would let the next locker lock a
fresh file while the old holder still holds the old one - two owners at once.

A resource is held in one of two modes:

- run: `agent-lock run NAME -- CMD` locks for one command only
- lease: `agent-lock acquire NAME` forks a detached holder that keeps the lock
  across many commands. `run` from the same owner then runs under the lease.
  The holder exits on `release`, when the owning agent process exits, or after
  an idle period without a `run`. A session-keyed lease belongs to the session
  that took it, so ending that session without `release` leaves the lease until
  the idle limit expires

One agent holds a resource by default. A NAME.limit file holding an integer N
from 1 to 64 turns the resource into a counting semaphore when N is
greater than one: N agents hold it at once, each on its own numbered slot
NAME.<i>.lock with its own records.
Separate slot files keep the lock, record and run machinery independent, so
claiming one slot never kills a command running on another.

Waiters register in NAME.queue/ with a priority from --priority. The highest
priority waits first, and waits are first-come-first-served inside a priority.
A waiter takes a slot only while it leads the queue, which a short flock on
NAME.queue.lock enforces. Dead waiters are pruned when their pid is gone; the
head is also checked against its recorded start time.

The owner is the nearest claude, codex or opencode process above this one, or
the calling shell when there is none. One process of a name in
SESSION_KEYED_AGENTS hosts many sessions, so there the owner is that process
and the session in its environment. NAME.json, or NAME.<i>.json for a slot,
records who holds a lock, but only the lock itself is authoritative - a record
is trusted only while the lock is taken and the process it names is still alive.

Every `run` records its command in NAME.runs/ (NAME.<i>.runs/ for a slot), with
a deadline that `extend` moves and `alarm` watches. A command can outlive the
lock: its runner can be killed with SIGKILL, or a lease can end under a running
command. So whoever takes the lock next first claims the resource - it kills
every recorded command still alive, and waits on NAME.runs.lock until no runner
from an old lease is left. Runs under a lease hold that file shared while they
run.
"""

from __future__ import annotations

import argparse
import contextlib
import fcntl
import functools
import hashlib
import json
import os
import re
import resource
import select
import signal
import subprocess
import sys
import time
from collections.abc import Iterator
from dataclasses import asdict, dataclass
from pathlib import Path
from typing import Any

DEFAULT_WAIT_S = 30 * 60
DEFAULT_IDLE_S = 15 * 60
DEFAULT_TIMEOUT_S = 60 * 60
DEFAULT_PRIORITY = 0
WAIT_POLL_S = 1.0
HOLDER_TICK_S = 5.0
RUN_TICK_S = 1.0
MIN_IDLE_S = 5 * RUN_TICK_S
KILL_GRACE_S = 5.0
CLAIM_TIMEOUT_S = 10 * 60
CLAIM_NOTICE_S = 30
PROCESS_CACHE_S = 5.0
BREAK_RECORD_GRACE_S = 2.0
HOLDER_READY_S = 10.0
DEFAULT_ALARM_BEFORE_S = 10 * 60
ALARM_START_GRACE_S = 10.0
MAX_FD_TO_CLOSE = 65536
MAX_SLOTS = 64

EXIT_NOT_OWNER = 1
EXIT_BAD_CONFIG = 2
EXIT_BUSY = 75
EXIT_TIMED_OUT = 124
EXIT_SIGNAL_BASE = 128

AGENT_PROCESS_NAMES = ("claude", "codex", "opencode")
SESSION_ENV_VARS = ("CLAUDE_CODE_SESSION_ID", "OPENCODE_SESSION_ID")
AGENT_SESSION_VARS = {
    "claude": "CLAUDE_CODE_SESSION_ID",
    "opencode": "OPENCODE_SESSION_ID",
}
SESSION_KEYED_AGENTS: tuple[str, ...] = ("opencode",)
OWNER_PID_ENV = "AGENT_LOCK_OWNER_PID"
STATE_DIR_ENV = "AGENT_LOCK_DIR"

LEASE = "lease"
RUN = "run"

NAME_PATTERN = re.compile(r"[A-Za-z0-9][A-Za-z0-9_-]*")
DURATION_PATTERN = re.compile(r"([0-9]+)([smh]?)")
DURATION_UNITS_S = {"": 1, "s": 1, "m": 60, "h": 3600}
RESERVED_STEMS = (".runs", ".queue")
MONTH_NUMBERS = {
    "Jan": 1, "Feb": 2, "Mar": 3, "Apr": 4, "May": 5, "Jun": 6,
    "Jul": 7, "Aug": 8, "Sep": 9, "Oct": 10, "Nov": 11, "Dec": 12,
}
PS_START_FIELDS = 5


class BusyError(Exception):
    """The resource stayed locked by someone else for the whole wait."""


class ConfigError(Exception):
    """A hand-edited resource configuration is invalid."""


class IdentityError(Exception):
    """The process cannot be identified through ps."""


class ReleasedError(Exception):
    """A holder was told to stop by a signal."""


@dataclass(frozen=True)
class Owner:
    """The long-lived process a lock is held on behalf of."""

    pid: int
    started: str
    label: str
    session: str = ""

    @property
    def process_key(self) -> str:
        return f"{self.pid}@{self.started}"

    @property
    def key(self) -> str:
        if self.session:
            return f"{self.process_key}#{self.session}"
        return self.process_key

    def owns(self, key: str) -> bool:
        """Whether a recorded owner key is ours.

        A key without a session was recorded by a caller with no session, and
        any session of the same process matches it.
        """
        return key in (self.key, self.process_key)


@dataclass(frozen=True)
class Holder:
    """Who holds a lock, as recorded in NAME.json."""

    pid: int
    started: str
    mode: str
    owner_key: str
    owner_pid: int
    owner_label: str
    purpose: str
    since: float


@dataclass(frozen=True)
class Resource:
    """The files that belong to one slot of a lockable resource."""

    name: str
    directory: Path
    index: int | None = None

    def path(self, suffix: str) -> Path:
        stem = self.name if self.index is None else f"{self.name}.{self.index}"
        return self.directory / f"{stem}.{suffix}"

    @property
    def lock(self) -> Path:
        return self.path("lock")

    @property
    def record(self) -> Path:
        return self.path("json")

    @property
    def beat(self) -> Path:
        return self.path("beat")

    @property
    def last(self) -> Path:
        return self.path("last.json")

    @property
    def runs(self) -> Path:
        return self.path("runs")

    @property
    def runs_lock(self) -> Path:
        return self.path("runs.lock")

    @property
    def extend_lock(self) -> Path:
        return self.path("extend.lock")


@dataclass(frozen=True)
class ResourceGroup:
    """One resource and the slots its limit allows."""

    name: str
    directory: Path
    limit: int

    def path(self, suffix: str) -> Path:
        return self.directory / f"{self.name}.{suffix}"

    @property
    def queue(self) -> Path:
        return self.path("queue")

    @property
    def queue_lock(self) -> Path:
        return self.path("queue.lock")

    @property
    def queue_seq(self) -> Path:
        return self.path("queue.seq")

    @property
    def slots(self) -> list[Resource]:
        if self.limit == 1:
            return [Resource(self.name, self.directory)]
        return [
            Resource(self.name, self.directory, index) for index in range(self.limit)
        ]

    def label(self, res: Resource) -> str:
        if res.index is None:
            return self.name
        return f"{self.name}[{res.index}]"


@dataclass(frozen=True)
class RunRecord:
    """One command started by `run`, as recorded in NAME.runs/RUNNER_PID.json."""

    runner_pid: int
    runner_started: str
    owner_key: str
    owner_label: str
    command: str
    cmd_pid: int
    cmd_started: str
    deadline: float | None


@dataclass(frozen=True)
class Waiter:
    """One caller waiting for a slot, as recorded in NAME.queue/."""

    sequence: int
    priority: int
    pid: int
    started: str
    owner_label: str


def state_dir() -> Path:
    """Directory that holds every resource's lock and records."""
    if override := os.environ.get(STATE_DIR_ENV):
        return Path(override).resolve()
    base = os.environ.get("XDG_STATE_HOME") or Path.home() / ".local" / "state"
    return (Path(base) / "agent-locks").resolve()


def owner_lock(directory: Path, name: str, owner: Owner) -> Path:
    """Serialize one owner's acquires of one resource, not other resources."""
    digest = hashlib.sha256(f"{name}|{owner.key}".encode()).hexdigest()[:16]
    return directory / f".owner-{digest}.lock"


def say(message: str) -> None:
    print(f"agent-lock: {message}", file=sys.stderr, flush=True)


def format_duration(seconds: float) -> str:
    seconds = int(seconds)
    hours, rest = divmod(seconds, 3600)
    minutes, secs = divmod(rest, 60)
    if hours:
        return f"{hours}h{minutes:02d}m"
    return f"{minutes}m{secs:02d}s" if minutes else f"{secs}s"


def ps_rows(*selector: str, column: str = "ppid") -> list[tuple[int, int, str, str]]:
    """Rows of (pid, column, start time, command) from ps."""
    result = subprocess.run(
        ["ps", *selector, "-o", f"pid=,{column}=,lstart=,comm="],
        capture_output=True,
        text=True,
        env={**os.environ, "LC_ALL": "C"},
    )
    rows = []
    for line in result.stdout.splitlines():
        fields = line.split(maxsplit=2 + PS_START_FIELDS)
        if len(fields) == 3 + PS_START_FIELDS:
            started = " ".join(fields[2 : 2 + PS_START_FIELDS])
            rows.append((int(fields[0]), int(fields[1]), started, fields[-1]))
    return rows


@functools.lru_cache(maxsize=512)
def _process_info_bucket(pid: int, bucket: int) -> tuple[str | None, str]:
    result = subprocess.run(
        ["ps", "-p", str(pid), "-o", "lstart=,stat="],
        capture_output=True,
        text=True,
        env={**os.environ, "LC_ALL": "C"},
    )
    fields = result.stdout.split()
    if len(fields) < 6:
        return None, ""
    return " ".join(fields[:5]), fields[5]


def process_info(pid: int) -> tuple[str | None, str]:
    """Start time and state from one ps call, shared for a short bucket."""
    return _process_info_bucket(pid, int(time.monotonic() / PROCESS_CACHE_S))


def start_time(pid: int) -> str | None:
    """Start time of a live process, which tells it apart from a reused pid."""
    return process_info(pid)[0]


def start_time_live(pid: int) -> str | None:
    """Uncached start time for decisions that signal another process."""
    rows = ps_rows("-p", str(pid))
    return rows[0][2] if rows else None


def is_same_process(pid: int, started: str) -> bool:
    return start_time(pid) == started


def is_same_process_live(pid: int, started: str) -> bool:
    return start_time_live(pid) == started


def parse_start(started: str) -> float:
    """Parse a C-locale ps start time without depending on the host locale."""
    _, month, day, clock, year = started.split()[:5]
    hour, minute, second = (int(part) for part in clock.split(":"))
    return time.mktime(
        (int(year), MONTH_NUMBERS[month], int(day), hour, minute, second, 0, 0, -1)
    )


def find_owner() -> Owner:
    """The nearest agent process above us, else the shell that called us."""
    if override := os.environ.get(OWNER_PID_ENV):
        pid = int(override)
        return Owner(pid, start_time(pid) or "", f"pid {pid}")
    table = {pid: (ppid, started, cmd) for pid, ppid, started, cmd in ps_rows("-A")}
    pid = os.getppid()
    while pid in table:
        ppid, started, command = table[pid]
        name = Path(command).name
        if name in AGENT_PROCESS_NAMES:
            session = env_session(name)
            label = f"{name} pid {pid}" + (f" session {session}" if session else "")
            keyed = session if name in SESSION_KEYED_AGENTS else ""
            return Owner(pid, started, label, keyed)
        pid = ppid
    pid = os.getppid()
    return Owner(pid, table.get(pid, (0, "", ""))[1], f"shell pid {pid}")


def env_session(agent: str = "") -> str:
    """The session id for this agent, never another agent's variable."""
    var = AGENT_SESSION_VARS.get(agent)
    return os.environ.get(var, "") if var else ""


def try_lock(path: Path) -> int | None:
    """Return a descriptor that holds the lock, or None if it is taken.

    This has to be flock, not lockf/fcntl locks. A flock belongs to the open
    file, so a forked holder keeps it after the parent closes its copy. POSIX
    record locks belong to a process and do not survive the fork.
    """
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        return None
    return fd


def is_locked(res: Resource) -> bool:
    fd = try_lock(res.lock)
    if fd is None:
        return True
    os.close(fd)
    return False


def write_json(path: Path, data: dict[str, object]) -> None:
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(data, indent=2) + "\n")
    os.replace(tmp, path)


def read_json(path: Path) -> dict[str, Any] | None:
    """Parse a record. Any, because JSON values carry no static type."""
    try:
        data = json.loads(path.read_text())
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        return None
    return data if isinstance(data, dict) else None


def read_holder(res: Resource) -> Holder | None:
    data = read_json(res.record)
    try:
        return Holder(**data) if data else None
    except TypeError:
        return None


def live_holder(res: Resource) -> Holder | None:
    """The recorded holder, if the lock is taken and that holder still runs.

    None while locked means a new holder has the lock but has not written its
    record yet.
    """
    if not is_locked(res):
        return None
    holder = read_holder(res)
    if holder and is_same_process(holder.pid, holder.started):
        return holder
    return None


def lease_of(res: Resource, owner: Owner) -> Holder | None:
    holder = live_holder(res)
    if holder and holder.mode == LEASE and owner.owns(holder.owner_key):
        return holder
    return None


def find_lease(group: ResourceGroup, owner: Owner) -> Resource | None:
    """The slot whose lease belongs to this owner, if there is one."""
    for res in group.slots:
        if lease_of(res, owner) is not None:
            return res
    return None


def describe(holder: Holder) -> str:
    purpose = f", {holder.purpose!r}" if holder.purpose else ""
    age = format_duration(time.time() - holder.since)
    return f"held by {holder.owner_label} ({holder.mode}{purpose}, for {age})"


def describe_lock(res: Resource) -> str:
    """Explain a slot's state, telling a dead holder from one not recorded yet."""
    if not is_locked(res):
        return "free"
    holder = read_holder(res)
    if holder is None:
        return "locked (holder record not written yet)"
    if not is_same_process(holder.pid, holder.started):
        return f"locked by a dead holder pid {holder.pid}, {holder.owner_label}"
    return describe(holder)


def describe_group(group: ResourceGroup) -> str:
    """What currently holds the group's slots, for wait messages."""
    held = [state for res in group.slots if (state := describe_lock(res)) != "free"]
    return "; ".join(held) if held else "free"


def waiter_path(group: ResourceGroup, waiter: Waiter) -> Path:
    return group.queue / f"{waiter.sequence:020d}-{waiter.pid}.json"


def register_waiter(
    group: ResourceGroup, owner: Owner, priority: int
) -> tuple[Waiter, Path]:
    """Join the queue with a ticket and file written as one locked step.

    Raises:
        IdentityError: the process cannot be identified through ps
    """
    pid = os.getpid()
    started = start_time(pid)
    if not started:
        raise IdentityError("agent-lock cannot identify its own process through ps")
    fd = os.open(group.queue_lock, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        group.queue.mkdir(exist_ok=True)
        data = read_json(group.queue_seq)
        previous = data.get("sequence") if data else None
        sequence = previous + 1 if isinstance(previous, int) else 1
        waiter = Waiter(sequence, priority, pid, started, owner.label)
        path = waiter_path(group, waiter)
        write_json(group.queue_seq, {"sequence": sequence})
        write_json(path, asdict(waiter))
        return waiter, path
    finally:
        os.close(fd)


def process_alive(pid: int) -> bool:
    """Whether the pid is live and not a zombie awaiting its parent."""
    started, state = process_info(pid)
    return bool(started) and not state.startswith("Z")


def live_waiters(group: ResourceGroup) -> list[Waiter]:
    """Waiting callers whose pid still exists, in service order."""
    waiters = []
    for path in group.queue.glob("*.json"):
        data = read_json(path)
        try:
            waiter = Waiter(**data) if data else None
        except TypeError:
            waiter = None
        if waiter is None or not process_alive(waiter.pid):
            path.unlink(missing_ok=True)
            continue
        waiters.append(waiter)
    return sorted(waiters, key=lambda w: (-w.priority, w.sequence))


def take_head_slot(
    group: ResourceGroup, waiter: Waiter
) -> tuple[Resource, int] | None:
    """Lock a free slot only while this waiter leads the queue."""
    fd = os.open(group.queue_lock, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        head = None
        for candidate in live_waiters(group):
            if is_same_process(candidate.pid, candidate.started):
                head = candidate
                break
            waiter_path(group, candidate).unlink(missing_ok=True)
        if head is None or (head.pid, head.sequence) != (waiter.pid, waiter.sequence):
            return None
        for res in group.slots:
            slot_fd = try_lock(res.lock)
            if slot_fd is not None:
                return res, slot_fd
        return None
    finally:
        os.close(fd)


def acquire_slot(
    group: ResourceGroup, owner: Owner, wait_s: float, priority: int
) -> tuple[Resource, int] | None:
    """Wait for a slot, or return None if this owner now holds a lease.

    Raises:
        BusyError: every slot stayed taken for wait_s
    """
    if find_lease(group, owner) is not None:
        return None
    deadline = time.monotonic() + wait_s
    announced = False
    waiter, path = register_waiter(group, owner, priority)
    try:
        while True:
            if find_lease(group, owner) is not None:
                return None
            taken = take_head_slot(group, waiter)
            if taken is not None:
                return taken
            state = describe_group(group)
            if time.monotonic() >= deadline:
                raise BusyError(f"{group.name} is still {state}")
            if not announced:
                if state == "free":
                    message = f"{group.name} is free - waiting for your turn"
                else:
                    message = (
                        f"{group.name} is {state} - waiting up to "
                        f"{format_duration(wait_s)}"
                    )
                say(f"{message} (priority {priority})")
                announced = True
            time.sleep(WAIT_POLL_S)
    finally:
        path.unlink(missing_ok=True)


def read_limit(directory: Path, name: str) -> int:
    """The slot count from NAME.limit, or one when the file is absent."""
    path = directory / f"{name}.limit"
    if not path.exists():
        return 1
    try:
        text = path.read_text().strip()
    except OSError as exc:
        raise ConfigError(f"cannot read {path}: {exc.strerror}") from exc
    try:
        limit = int(text) if re.fullmatch(r"[0-9]+", text) else 0
    except ValueError as exc:
        raise ConfigError(f"{path} holds an integer that is too large") from exc
    if not 1 <= limit <= MAX_SLOTS:
        raise ConfigError(f"{path} must hold an integer from 1 to {MAX_SLOTS}")
    return limit


def load_group(directory: Path, name: str) -> ResourceGroup:
    return ResourceGroup(name, directory, read_limit(directory, name))


def stray_slots(group: ResourceGroup) -> list[int]:
    """Slot indices left behind by a larger limit."""
    prefix, suffix = f"{group.name}.", ".lock"
    indices = []
    for path in group.directory.glob(f"{prefix}*{suffix}"):
        stem = path.name[len(prefix) : -len(suffix)]
        if re.fullmatch(r"[0-9]+", stem):
            indices.append(int(stem))
    minimum = group.limit if group.limit > 1 else 0
    return sorted(i for i in indices if i >= minimum)


def record_holder(res: Resource, owner: Owner, mode: str, purpose: str) -> None:
    pid = os.getpid()
    holder = Holder(
        pid=pid,
        started=start_time(pid) or "",
        mode=mode,
        owner_key=owner.key,
        owner_pid=owner.pid,
        owner_label=owner.label,
        purpose=purpose,
        since=time.time(),
    )
    write_json(res.record, asdict(holder))


def clear_holder(res: Resource, reason: str) -> None:
    """Drop our record and note why. Call it while still holding the lock."""
    holder = read_holder(res)
    if holder is None or holder.pid != os.getpid():
        return
    last = {"owner_label": holder.owner_label, "purpose": holder.purpose}
    write_json(res.last, {**last, "reason": reason, "at": time.time()})
    res.record.unlink(missing_ok=True)


def run_records(res: Resource) -> list[tuple[Path, RunRecord]]:
    records = []
    for path in sorted(res.runs.glob("*.json")):
        data = read_json(path)
        with contextlib.suppress(TypeError):
            records.append((path, RunRecord(**data or {})))
    return records


def live_runs(res: Resource, owner: Owner) -> list[tuple[Path, RunRecord]]:
    """The owner's runs whose runner is still alive."""
    return [
        (path, run)
        for path, run in run_records(res)
        if owner.owns(run.owner_key)
        and is_same_process(run.runner_pid, run.runner_started)
    ]


def is_our_group(run: RunRecord) -> bool:
    """Whether the command's process group still exists and is the one we started.

    A pid is not reused while a process group with that id exists. When the
    leader is gone, every member left must have started after the command did -
    a group that a reused pid leads now would have a leader with another start.
    """
    members = [
        (pid, started)
        for pid, pgid, started, _ in ps_rows("-A", column="pgid")
        if pgid == run.cmd_pid
    ]
    leader = [started for pid, started in members if pid == run.cmd_pid]
    if leader:
        return not run.cmd_started or leader[0] == run.cmd_started
    if not run.cmd_started:
        return bool(members)
    since = parse_start(run.cmd_started)
    return bool(members) and all(parse_start(s) >= since for _, s in members)


def signal_group(pgid: int, signum: int) -> bool:
    """Signal a process group. Return whether any member could take the signal.

    macOS refuses with EPERM when only zombies are left, so that counts as gone.
    """
    try:
        os.killpg(pgid, signum)
    except (ProcessLookupError, PermissionError):
        return False
    return True


def terminate_group(pgid: int) -> bool:
    """Stop a process group. Return whether every member is gone."""
    deadline = time.monotonic() + KILL_GRACE_S
    is_alive = signal_group(pgid, signal.SIGTERM)
    while is_alive and time.monotonic() < deadline:
        time.sleep(WAIT_POLL_S)
        is_alive = signal_group(pgid, 0)
    if not is_alive:
        return True
    signal_group(pgid, signal.SIGKILL)
    deadline = time.monotonic() + KILL_GRACE_S
    while is_alive and time.monotonic() < deadline:
        time.sleep(WAIT_POLL_S)
        is_alive = signal_group(pgid, 0)
    return not is_alive


def reap_orphans(res: Resource) -> None:
    """Kill every recorded command and runner. Call it only while holding the lock."""
    for path, run in run_records(res):
        if is_our_group(run):
            say(f"killing {run.command!r}, left running by {run.owner_label}")
            if not terminate_group(run.cmd_pid):
                say(f"{run.command!r} is still alive - keeping its record")
                continue
        if is_same_process(run.runner_pid, run.runner_started):
            with contextlib.suppress(ProcessLookupError):
                os.kill(run.runner_pid, signal.SIGKILL)
        path.unlink(missing_ok=True)


def reap_dead_runners(res: Resource) -> None:
    """Reap commands whose runner died, leaving runs with a live runner alone."""
    for path, run in run_records(res):
        if is_same_process(run.runner_pid, run.runner_started):
            continue
        if is_our_group(run):
            say(f"killing {run.command!r}, left running by {run.owner_label}")
            terminate_group(run.cmd_pid)
        path.unlink(missing_ok=True)


def claim_blocker(res: Resource) -> str:
    """Describe the runner that keeps us from claiming this slot."""
    for path, run in run_records(res):
        if is_same_process(run.runner_pid, run.runner_started):
            return f"the runner of {run.command!r}"
    return "a runner from an old lease"


def claim(res: Resource) -> None:
    """Make a freshly locked resource ours alone, before anything else touches it.

    Runs under an old lease hold NAME.runs.lock shared. Once it locks
    exclusively, none of them is left, and reaping has stopped every command.

    Raises:
        BusyError: a runner still holds the slot after CLAIM_TIMEOUT_S
    """
    fd = os.open(res.runs_lock, os.O_RDWR | os.O_CREAT, 0o644)
    started = time.monotonic()
    next_notice = started + CLAIM_NOTICE_S
    try:
        while True:
            reap_orphans(res)
            with contextlib.suppress(BlockingIOError):
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return
            now = time.monotonic()
            if now >= next_notice:
                say(f"still waiting to claim {res.name}: {claim_blocker(res)}")
                next_notice = now + CLAIM_NOTICE_S
            if now - started >= CLAIM_TIMEOUT_S:
                raise BusyError(
                    f"could not claim {res.name}: {claim_blocker(res)} still holds it"
                )
            time.sleep(WAIT_POLL_S)
    finally:
        os.close(fd)


@contextlib.contextmanager
def signals_raise_released() -> Iterator[None]:
    def handler(signum: int, _frame: object) -> None:
        raise ReleasedError(signal.Signals(signum).name)

    for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(signum, handler)
    yield


def detach(keep: set[int]) -> None:
    """Leave the caller's session and drop every inherited descriptor.

    A tool that runs us waits until its output pipes close. A holder that kept
    a copy of them would hang that call for as long as the lease lasts.
    """
    os.setsid()
    os.chdir("/")
    devnull = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        os.dup2(devnull, fd)
    soft = resource.getrlimit(resource.RLIMIT_NOFILE)[0]
    limit = MAX_FD_TO_CLOSE if soft < 0 else min(soft, MAX_FD_TO_CLOSE)
    start = 3
    for fd in [*sorted(keep), limit]:
        os.closerange(start, fd)
        start = fd + 1


def hold_lease(res: Resource, owner: Owner, idle_s: float) -> str:
    """Keep the lock until a stop condition. Return why the lease ended."""
    since = time.time()
    try:
        with signals_raise_released():
            while True:
                if not is_same_process(owner.pid, owner.started):
                    return "owner process exited"
                beat = res.beat.stat().st_mtime if res.beat.exists() else since
                if idle_s and time.time() - max(beat, since) > idle_s:
                    return f"idle for {format_duration(idle_s)}"
                time.sleep(HOLDER_TICK_S)
    except ReleasedError as exc:
        return f"stopped by {exc}"


def start_holder(
    res: Resource, fd: int, owner: Owner, purpose: str, idle_s: float
) -> bool:
    """Fork the lease holder and report whether it recorded itself.

    The caller keeps fd until cleanup is done, then closes its copy.
    """
    ready_r, ready_w = os.pipe()
    child = os.fork()
    if child == 0:
        os.close(ready_r)
        detach(keep={fd, ready_w})
        reason = "holder crashed"
        try:
            record_holder(res, owner, LEASE, purpose)
            res.beat.touch()
            os.write(ready_w, b"1")
            os.close(ready_w)
            reason = hold_lease(res, owner, idle_s)
        finally:
            clear_holder(res, reason)
            os._exit(0)
    os.close(ready_w)
    readable, _, _ = select.select([ready_r], [], [], HOLDER_READY_S)
    is_ready = bool(readable) and os.read(ready_r, 1) == b"1"
    os.close(ready_r)
    if not is_ready:
        with contextlib.suppress(ProcessLookupError):
            os.kill(child, signal.SIGKILL)
        say(f"the holder for {res.name} did not become ready")
        return False
    return True


def kill_group(proc: subprocess.Popen[bytes]) -> None:
    """Stop the command's whole group, then reap the direct child."""
    terminate_group(proc.pid)
    with contextlib.suppress(ProcessLookupError, subprocess.TimeoutExpired):
        proc.wait(timeout=KILL_GRACE_S)


def start_run(
    res: Resource, owner: Owner, command: list[str], timeout_s: float
) -> tuple[subprocess.Popen[bytes], Path]:
    """Start a command in its own process group and record it in NAME.runs/."""
    res.runs.mkdir(exist_ok=True)
    proc = subprocess.Popen(command, start_new_session=True)
    try:
        pid = os.getpid()
        run = RunRecord(
            runner_pid=pid,
            runner_started=start_time(pid) or "",
            owner_key=owner.key,
            owner_label=owner.label,
            command=" ".join(command),
            cmd_pid=proc.pid,
            cmd_started=start_time(proc.pid) or "",
            deadline=time.time() + timeout_s if timeout_s else None,
        )
        path = res.runs / f"{pid}.json"
        write_json(path, asdict(run))
    except BaseException:
        terminate_group(proc.pid)
        proc.wait()
        raise
    return proc, path


def current_deadline(path: Path, fallback: float | None) -> float | None:
    """The run's deadline as `extend` last left it."""
    data = read_json(path)
    return data.get("deadline", fallback) if data else fallback


def run_command(
    res: Resource, owner: Owner, command: list[str], timeout_s: float, beat: bool
) -> int:
    """Run a command, killing its whole group once it passes its deadline.

    A signal sent to us goes to the whole group, so stopping agent-lock stops
    the command too. With beat set, NAME.beat is touched so a lease stays alive
    through a long command. The deadline is reread every tick, so `extend`
    takes effect at once.
    """
    proc, path = start_run(res, owner, command, timeout_s)

    def forward(signum: int, _frame: object) -> None:
        with contextlib.suppress(ProcessLookupError):
            os.killpg(proc.pid, signum)

    for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(signum, forward)
    deadline = None
    try:
        while True:
            if beat:
                res.beat.touch()
            deadline = current_deadline(path, deadline)
            remaining_s = deadline - time.time() if deadline else RUN_TICK_S
            with contextlib.suppress(subprocess.TimeoutExpired):
                code = proc.wait(timeout=max(min(RUN_TICK_S, remaining_s), 0))
                return code if code >= 0 else EXIT_SIGNAL_BASE - code
            if deadline and time.time() >= deadline:
                say(f"{' '.join(command)!r} ran past its deadline - killing it")
                kill_group(proc)
                return EXIT_TIMED_OUT
    finally:
        path.unlink(missing_ok=True)


def stop_holder(holder: Holder) -> None:
    """Signal a holder and wait until it has exited, escalating to SIGKILL."""
    if not is_same_process_live(holder.pid, holder.started):
        return
    os.kill(holder.pid, signal.SIGTERM)
    deadline = time.monotonic() + KILL_GRACE_S
    while time.monotonic() < deadline:
        if not is_same_process_live(holder.pid, holder.started):
            return
        time.sleep(WAIT_POLL_S)
    with contextlib.suppress(ProcessLookupError):
        os.kill(holder.pid, signal.SIGKILL)


def lock_holding_pids(path: Path) -> list[int]:
    """Linux pids with this lock file open, flock holders and bystanders alike."""
    target = str(path)
    pids = []
    for fd_dir in Path("/proc").glob("[0-9]*/fd"):
        try:
            if any(os.readlink(fd) == target for fd in fd_dir.iterdir()):
                pids.append(int(fd_dir.parent.name))
        except OSError:
            continue
    return pids


def cmd_acquire(group: ResourceGroup, args: argparse.Namespace) -> int:
    owner = find_owner()
    lock_fd = os.open(
        owner_lock(group.directory, group.name, owner), os.O_RDWR | os.O_CREAT, 0o644
    )
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX)
        return acquire_under_owner_lock(group, owner, args)
    finally:
        os.close(lock_fd)


def acquire_under_owner_lock(
    group: ResourceGroup, owner: Owner, args: argparse.Namespace
) -> int:
    """Take one lease for this owner while its owner lock is held."""
    existing = find_lease(group, owner)
    acquired = None
    if existing is None:
        acquired = acquire_slot(group, owner, args.wait, args.priority)
        if acquired is None:
            existing = find_lease(group, owner)
    if existing is not None:
        existing.beat.touch()
        say(f"you already hold {group.name}")
        return 0
    if acquired is None:
        say(f"could not take a slot on {group.name} - retry")
        return EXIT_BUSY
    res, fd = acquired
    claim(res)
    ready = start_holder(res, fd, owner, args.purpose, args.idle)
    if not ready:
        res.record.unlink(missing_ok=True)
    os.close(fd)
    if not ready:
        return EXIT_NOT_OWNER
    idle = format_duration(args.idle) if args.idle else "none"
    where = f" slot {res.index}" if group.limit > 1 else ""
    say(f"acquired {group.name}{where} for {owner.label} (idle limit {idle})")
    return 0


def run_under_lease(
    res: Resource, owner: Owner, args: argparse.Namespace
) -> int | None:
    """Run the command under the owner's lease, or return None if it has ended.

    The exclusive lock goes first so dead runners can be reaped without
    racing a live one. It then drops to shared, so a lease that ends after the
    check still leaves a run that the next claimer waits for.
    """
    fd = os.open(res.runs_lock, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        if lease_of(res, owner) is None:
            return None
        reap_dead_runners(res)
        fcntl.flock(fd, fcntl.LOCK_SH)
        return run_command(res, owner, args.command, args.timeout, beat=True)
    finally:
        os.close(fd)


def cmd_run(group: ResourceGroup, args: argparse.Namespace) -> int:
    owner = find_owner()
    while True:
        lease_slot = find_lease(group, owner)
        if lease_slot is not None:
            code = run_under_lease(lease_slot, owner, args)
            if code is not None:
                return code
            say(f"your lease on {group.name} ended - taking a slot for this command")
            continue
        acquired = acquire_slot(group, owner, args.wait, args.priority)
        if acquired is None:
            continue
        res, fd = acquired
        try:
            claim(res)
            record_holder(res, owner, RUN, args.purpose or " ".join(args.command))
            return run_command(res, owner, args.command, args.timeout, beat=False)
        finally:
            clear_holder(res, "command finished")
            os.close(fd)


def extend_slot(res: Resource, owner: Owner, amount: float) -> int:
    """Extend this owner's deadlines on one slot, serialized across callers."""
    fd = os.open(res.extend_lock, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        extended = 0
        for path, run in live_runs(res, owner):
            if not run.deadline:
                continue
            deadline = (current_deadline(path, run.deadline) or 0) + amount
            write_json(path, {**asdict(run), "deadline": deadline})
            if not is_same_process(run.runner_pid, run.runner_started):
                path.unlink(missing_ok=True)
                continue
            left = format_duration(deadline - time.time())
            say(f"{run.command!r} now has {left} before it is killed")
            extended += 1
        return extended
    finally:
        os.close(fd)


def cmd_extend(group: ResourceGroup, args: argparse.Namespace) -> int:
    owner = find_owner()
    extended = sum(extend_slot(res, owner, args.amount) for res in group.slots)
    if not extended:
        say(f"you run no command with a deadline on {group.name}")
        return EXIT_NOT_OWNER
    return 0


def cmd_alarm(group: ResourceGroup, args: argparse.Namespace) -> int:
    """Block until one of the owner's commands nears its deadline, or none is left."""
    owner = find_owner()
    started = time.monotonic()
    while True:
        runs = []
        for res in group.slots:
            runs.extend(live_runs(res, owner))
        if not runs and time.monotonic() - started >= ALARM_START_GRACE_S:
            print(f"done: no command of yours runs on {group.name}")
            return 0
        for path, run in runs:
            deadline = current_deadline(path, run.deadline)
            if deadline and deadline - time.time() <= args.before:
                left = format_duration(max(deadline - time.time(), 0))
                print(
                    f"deadline: {run.command!r} is killed in {left} - "
                    f"`agent-lock extend {group.name} DURATION` gives it more time"
                )
                return 0
        time.sleep(RUN_TICK_S)


def cmd_release(group: ResourceGroup, _args: argparse.Namespace) -> int:
    owner = find_owner()
    holders = []
    for res in group.slots:
        holder = lease_of(res, owner)
        if holder is not None:
            holders.append(holder)
    if not holders:
        say(f"you hold no lease on {group.name} - nothing to release")
        return 0
    for holder in holders:
        stop_holder(holder)
    say(f"released {group.name}")
    return 0


def cmd_break(group: ResourceGroup, args: argparse.Namespace) -> int:
    slots = group.slots
    if args.slot is not None:
        slot = args.slot
        if not 0 <= slot < MAX_SLOTS:
            say(f"{slot} is not a slot index (0 to {MAX_SLOTS - 1})")
            return EXIT_BAD_CONFIG
        exists = (group.directory / f"{group.name}.{slot}.lock").exists()
        if group.limit == 1 and not exists:
            say(f"{group.name} is a mutex - use `break {group.name}` without --slot")
            return EXIT_BAD_CONFIG
        if slot >= group.limit and not exists:
            say(f"{group.name} has no slot {slot}")
            return EXIT_BAD_CONFIG
        slots = [Resource(group.name, group.directory, slot)]
    else:
        slots += [Resource(group.name, group.directory, i) for i in stray_slots(group)]
    unresolved = False
    for res in slots:
        holder = live_holder(res)
        deadline = time.monotonic() + BREAK_RECORD_GRACE_S
        while holder is None and is_locked(res) and time.monotonic() < deadline:
            time.sleep(WAIT_POLL_S)
            holder = live_holder(res)
        if holder is None and is_locked(res):
            label = group.label(res)
            pids = [pid for pid in lock_holding_pids(res.lock) if pid != os.getpid()]
            say(
                f"{label} is {describe_lock(res)} - no holder record; pids with "
                f"the lock file open: {pids or 'unknown'}. Stop the flock holder "
                "yourself, or restore NAME.limit"
            )
            unresolved = True
            continue
        if holder:
            stop_holder(holder)
            say(f"broke {group.label(res)}, which was {describe(holder)}")
        if (fd := try_lock(res.lock)) is not None:
            claim(res)
            os.close(fd)
    return EXIT_NOT_OWNER if unresolved else 0


def run_lines(res: Resource) -> list[str]:
    lines = []
    for path, run in run_records(res):
        if not is_same_process(run.runner_pid, run.runner_started):
            continue
        deadline = current_deadline(path, run.deadline)
        left = format_duration(deadline - time.time()) if deadline else "no deadline"
        lines.append(f"  running {run.command!r} for {run.owner_label}, {left} left")
    return lines


def status_line(res: Resource, label: str) -> str:
    if is_locked(res):
        holder = live_holder(res)
        line = f"{label}: {describe_lock(res)}"
        if holder and holder.mode == LEASE and res.beat.exists():
            idle = format_duration(time.time() - res.beat.stat().st_mtime)
            line += f", idle {idle}"
        return "\n".join([line, *run_lines(res)])
    last = read_json(res.last)
    if not last:
        return f"{label}: free"
    ago = format_duration(time.time() - float(last.get("at", 0)))
    who, reason = last.get("owner_label"), last.get("reason")
    return f"{label}: free - {who} let go {ago} ago ({reason})"


def resource_names(directory: Path) -> list[str]:
    """Resource names inferred from the files left in the state directory."""
    names: set[str] = set()
    for path in directory.iterdir():
        name = path.name
        if name.endswith(".limit"):
            names.add(name[: -len(".limit")])
        elif name.endswith(".lock"):
            stem = name[: -len(".lock")]
            if stem.endswith(RESERVED_STEMS):
                continue
            if "." in stem:
                base, _, tail = stem.rpartition(".")
                if re.fullmatch(r"[0-9]+", tail):
                    names.add(base)
            else:
                names.add(stem)
    return sorted(names)


def cmd_status(directory: Path, name: str | None) -> int:
    names = [name] if name else resource_names(directory)
    if not names:
        print("no resources yet")
        return 0
    broken = False
    for each in names:
        try:
            group = load_group(directory, each)
        except ConfigError as exc:
            say(str(exc))
            broken = True
            continue
        if group.limit > 1:
            print(f"{group.name}: {group.limit} slots")
        if stray := stray_slots(group):
            print(f"{group.name}: warning - slot files {stray} from a larger limit")
            for index in stray:
                res = Resource(group.name, group.directory, index)
                print(status_line(res, group.label(res)))
        for res in group.slots:
            print(status_line(res, group.label(res)))
    return EXIT_BAD_CONFIG if broken else 0


def resource_name(value: str) -> str:
    if not NAME_PATTERN.fullmatch(value):
        raise argparse.ArgumentTypeError(f"{value!r} is not a valid resource name")
    return value


def duration(value: str) -> float:
    match = DURATION_PATTERN.fullmatch(value)
    if not match:
        raise argparse.ArgumentTypeError(
            f"{value!r} is not a duration like 90, 15m or 2h"
        )
    try:
        return float(int(match[1]) * DURATION_UNITS_S[match[2]])
    except OverflowError as exc:
        raise argparse.ArgumentTypeError(f"{value!r} is too large") from exc


def idle_duration(value: str) -> float:
    """An idle limit long enough that a running command's heartbeat keeps up."""
    seconds = duration(value)
    if 0 < seconds < MIN_IDLE_S:
        raise argparse.ArgumentTypeError(
            f"--idle must be 0 or at least {MIN_IDLE_S:g}s"
        )
    return seconds


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="agent-lock",
        description="Share a named resource between agents through a kernel file lock.",
        epilog="Durations take s, m or h. --idle 0 and --timeout 0 disable the "
        f"limit, --wait 0 does not wait. Higher --priority waits first. "
        f"Exit {EXIT_BUSY}: still busy after --wait. "
        f"Exit {EXIT_TIMED_OUT}: the command was killed at its deadline.",
    )
    commands = parser.add_subparsers(dest="action", required=True)
    acquire = commands.add_parser(
        "acquire", help="take a lease that lasts across commands"
    )
    run = commands.add_parser("run", help="run one command while holding the resource")
    for sub in (acquire, run):
        sub.add_argument("name", type=resource_name)
        sub.add_argument("--purpose", default="", help="shown to agents that wait")
        sub.add_argument("--wait", type=duration, default=DEFAULT_WAIT_S)
        sub.add_argument(
            "--priority",
            type=int,
            default=DEFAULT_PRIORITY,
            help="higher values wait first; FIFO inside one level",
        )
    acquire.add_argument(
        "--idle",
        type=idle_duration,
        default=DEFAULT_IDLE_S,
        help="end the lease after this long without a run",
    )
    run.add_argument(
        "--timeout",
        type=duration,
        default=DEFAULT_TIMEOUT_S,
        help="kill the command after this long, unless extended",
    )
    extend = commands.add_parser("extend", help="give your running commands more time")
    extend.add_argument("name", type=resource_name)
    extend.add_argument("amount", type=duration, help="added to each deadline")
    alarm = commands.add_parser(
        "alarm", help="wait until your command nears its deadline or ends"
    )
    alarm.add_argument("name", type=resource_name)
    alarm.add_argument(
        "--before",
        type=duration,
        default=DEFAULT_ALARM_BEFORE_S,
        help="how long before the deadline to exit",
    )
    commands.add_parser("release", help="end your lease").add_argument(
        "name", type=resource_name
    )
    break_cmd = commands.add_parser("break", help="stop whoever holds it")
    break_cmd.add_argument("name", type=resource_name)
    break_cmd.add_argument(
        "--slot", type=int, help="stop only this slot of a semaphore"
    )
    commands.add_parser("status", help="show holders").add_argument(
        "name", type=resource_name, nargs="?"
    )
    return parser


def main() -> int:
    argv = sys.argv[1:]
    split = argv.index("--") if "--" in argv else len(argv)
    parser = build_parser()
    args = parser.parse_args(argv[:split])
    args.command = argv[split + 1 :]
    if (args.action == "run") != bool(args.command):
        parser.error("run, and only run, takes a command after --")
    directory = state_dir()
    directory.mkdir(parents=True, exist_ok=True)
    if args.action == "status":
        return cmd_status(directory, args.name)
    try:
        group = load_group(directory, args.name)
    except ConfigError as exc:
        say(str(exc))
        return EXIT_BAD_CONFIG
    if args.action != "break" and (
        held := [
            index
            for index in stray_slots(group)
            if is_locked(Resource(group.name, directory, index))
        ]
    ):
        say(
            f"{group.name}: slots {held} are still locked from a larger limit - "
            "restore NAME.limit or stop the holder process"
        )
        return EXIT_BAD_CONFIG
    handlers = {
        "acquire": cmd_acquire,
        "run": cmd_run,
        "release": cmd_release,
        "break": cmd_break,
        "extend": cmd_extend,
        "alarm": cmd_alarm,
    }
    try:
        return handlers[args.action](group, args)
    except BusyError as exc:
        say(str(exc))
        return EXIT_BUSY
    except IdentityError as exc:
        say(str(exc))
        return EXIT_NOT_OWNER


if __name__ == "__main__":
    sys.exit(main())
